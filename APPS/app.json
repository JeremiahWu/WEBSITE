{
  "expo": {
    "name": "老吴咖啡",
    "slug": "labsoft-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "labsoft",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.labsoft.app"
    },
    "android": {
      "package": "com.labsoft.app",
      "adaptiveIcon": {
        "backgroundColor": "#2BBFE0"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": ["expo-router"]
  }
}
