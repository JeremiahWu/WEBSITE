{
  "name": "labsoft",
  "version": "1.0.0",
  "private": true,
  "description": "老吴咖啡实验室 - 软件基础服务 (LABSOFT)",
  "workspaces": [
    "HOME",
    "CORE",
    "APPS"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=HOME",
    "dev:api": "npm run dev --workspace=CORE",
    "dev:app": "npm run start --workspace=APPS",
    "build:web": "npm run build --workspace=HOME",
    "build:api": "npm run build --workspace=CORE",
    "dev:docker": "docker compose up -d",
    "dev": "npm run dev:web"
  }
}
